{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stance",
  "version": "0.1.0",
  "identifier": "com.stance.portfolio",
  "build": {
    "beforeDevCommand": "node desktop/dev.mjs",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop/frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/stance-node"],
    "resources": {
      "../.next/standalone/": "next-server/",
      "../desktop/server.mjs": "desktop/server.mjs",
      "../prisma/migrations/": "prisma/migrations/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
