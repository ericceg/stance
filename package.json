{
  "name": "persport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node scripts/ensure-db.mjs && prisma migrate deploy && prisma db seed",
