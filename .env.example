# Local SQLite database. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Trading 212 read-only Public API credentials. Generate a key with account,
# portfolio, and history read permissions. Never prefix either value with
# NEXT_PUBLIC_. Use "demo" for a paper-trading account or "live" for real data.
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=live

# Reserved for live quote polling in Milestone 2.
QUOTE_REFRESH_INTERVAL_MS=10000
