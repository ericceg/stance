# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# local visual-review artifacts
/output/

# next.js
/.next/
/out/

# production
/build
/src-tauri/target
/src-tauri/binaries/stance-node-*
